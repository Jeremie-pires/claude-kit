{
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.js\""
  },
  "env": {
    "DO_NOT_TRACK": "1"
  },
  "permissions": {
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -Rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(~/.claude/settings.json.bak-*)",
      "Skill(caveman:caveman-setup)",
      "Skill(caveman:caveman-manage)",
      "Skill(caveman:caveman-optimize)",
      "Skill(caveman:caveman-discover)",
      "Skill(caveman:caveman-evidence-review)",
      "Skill(caveman:caveman-learn)"
    ]
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": { "source": "git", "url": "https://github.com/addyosmani/agent-skills.git" }
    },
    "caveman": {
      "source": { "source": "github", "repo": "JuliusBrussee/caveman" }
    }
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "caveman@caveman": true,
    "claude-kit@workshop": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/.claude-kit/bootstrap.ps1\" -Apply -Quiet",
            "async": true,
            "timeout": 180
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "model": "sonnet"
}
